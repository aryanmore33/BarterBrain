# Stage 1: Dependencies
FROM node:24.20.0-alpine3.24 AS dependencies

WORKDIR /server

COPY package*.json ./

RUN npm ci --omit=dev


# Stage 2: Production
FROM node:24.20.0-alpine3.24 AS production

WORKDIR /server

# Update Alpine security packages
RUN apk update && apk upgrade

# Remove package managers from production image
RUN rm -rf \
    /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack

# Copy production dependencies
COPY --from=dependencies /server/node_modules ./node_modules

# Copy application
COPY . .

ENV NODE_ENV=production

EXPOSE 3000

USER node

CMD ["node", "server.js"]